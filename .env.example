CORS_ORIGINS=http://localhost:3000
CHUNK_TARGET_TOKENS=650
CHUNK_OVERLAP_RATIO=0.125
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Uncomment once the model above has downloaded successfully at least once.
# Skips a network metadata check on every server startup (faster, and
# avoids depending on Hugging Face's CDN being reachable every time).
# HF_HUB_OFFLINE=1

# Primary LLM for answer generation (Milestone 6) and RAGAS judging (Milestone 9).
# Get a key at https://console.anthropic.com/ — never commit the real value.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Fallback LLM used automatically if Anthropic fails (credit exhausted, rate
# limited, timed out, etc.) — free tier at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
LLM_FALLBACK_MODEL=gemini-2.5-flash

RETRIEVAL_TOP_K=5
LOG_LEVEL=INFO

# Shared credentials gating the credit-consuming endpoints (/api/upload,
# /api/query, /api/ask) so random visitors can't run up the LLM bill.
# CHANGE THESE before any real deployment — defaults are for local dev only.
AUTH_USERNAME=studylens
AUTH_PASSWORD=studylens-demo-2026
